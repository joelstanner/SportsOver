{
  "name": "sportsover",
  "version": "0.38.1",
  "private": true,
  "description": "Standalone desktop sports banner",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --require ./scripts/offline-network.cjs --test tests/core/*.test.js tests/sports/*/*.test.js tests/desktop/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:mode": "node scripts/test-mode.cjs",
    "test:network": "node scripts/test-network-smoke.cjs",
    "build:mac": "node scripts/build-mac.cjs",
    "dist:mac": "node scripts/dist-mac.cjs",
    "test:elite": "node tests/browser/elite-auto-follow.cjs",
    "test:elite:desktop": "ELITE_DESKTOP=1 node tests/browser/elite-auto-follow.cjs",
    "test:chess": "node tests/browser/chess.cjs",
    "test:chess:desktop": "node scripts/chess-desktop-smoke.cjs",
    "test:pdga": "node tests/browser/pdga.cjs",
    "test:f1": "node tests/browser/formula-1.cjs",
    "test:pdga:live": "node scripts/pdga-desktop-smoke.cjs",
    "build:win": "node scripts/build-win.cjs",
    "dist:win": "node scripts/dist-win.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "test:obs": "node tests/browser/obs-layouts.cjs",
    "test:providers": "node scripts/provider-contracts.cjs --live",
    "test:providers:pdga": "node scripts/provider-contracts.cjs --live pdga",
    "test:providers:espn": "node scripts/provider-contracts.cjs --live espn",
    "test:providers:mlb": "node scripts/provider-contracts.cjs --live mlb",
    "test:providers:lichess": "node scripts/provider-contracts.cjs --live lichess",
    "test:offline-boundaries": "node scripts/offline-boundaries-smoke.cjs",
    "test:browser:network": "node scripts/browser-network-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.17.0",
    "playwright": "1.63.0"
  },
  "license": "MIT",
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
