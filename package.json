{
  "name": "sportsover",
  "version": "0.34.2",
  "private": true,
  "description": "Standalone desktop sports banner",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/core/*.test.js tests/sports/*/*.test.js tests/desktop/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:mode": "node scripts/test-mode.cjs",
    "build:mac": "node scripts/build-mac.cjs",
    "dist:mac": "node scripts/dist-mac.cjs",
    "test:elite": "node tests/browser/elite-auto-follow.cjs",
    "test:elite:desktop": "ELITE_DESKTOP=1 node tests/browser/elite-auto-follow.cjs",
    "test:chess": "node tests/browser/chess.cjs",
    "test:chess:desktop": "node scripts/chess-desktop-smoke.cjs",
    "test:pdga": "node tests/browser/pdga.cjs",
    "test:pdga:live": "node scripts/pdga-desktop-smoke.cjs",
    "build:win": "node scripts/build-win.cjs",
    "dist:win": "node scripts/dist-win.cjs",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.17.0",
    "playwright": "1.63.0"
  },
  "license": "MIT",
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
